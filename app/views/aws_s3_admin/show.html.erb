<%= render partial: 'aws_admin/tabs', locals: { selected: 's3' } %>
<%= render_error_messages(@errors) %>

<% unless RedmineAws::S3.enabled? %>
<p class="warning"><%= l(:text_aws_s3_off, name: RedmineAws::S3::ENV_BUCKET) %></p>
<% end %>

<h3><%= l(:label_aws_s3_environment) %></h3>

<div class="box tabular settings">
  <% [[:bucket, RedmineAws::S3::ENV_BUCKET, RedmineAws::S3.bucket],
      [:region, RedmineAws::S3::ENV_REGION, RedmineAws::S3.region],
      [:domain, RedmineAws::S3::ENV_DOMAIN, RedmineAws::S3.cloudfront_domain],
      [:key_pair_id, RedmineAws::S3::ENV_KEY_PAIR_ID, RedmineAws::S3.key_pair_id],
      [:private_key, RedmineAws::S3::ENV_PRIVATE_KEY,
       l(RedmineAws::S3.private_key? ? :label_aws_s3_set : :label_aws_s3_not_set)],
      [:malware_scan, RedmineAws::S3::ENV_MALWARE_SCAN,
       l(RedmineAws::S3.malware_scan? ? :label_aws_s3_enabled : :label_aws_s3_disabled)]].each do |name, env, value| %>
  <p><label><%= l(:"field_aws_s3_#{name}") %></label><%= value || '-' %> <em class="info"><%= env %></em></p>
  <% end %>
  <p><label><%= l(:field_aws_s3_storage_path) %></label><%= Attachment.storage_path %> <em class="info">attachments_storage_path</em></p>
</div>

<% if RedmineAws::S3.enabled? %>
<h3><%= l(:label_aws_s3_checks) %></h3>

<p>
  <%= link_to l(:button_aws_s3_read_write), aws_s3_admin_read_write_path, method: :post %> |
  <%= link_to l(:button_aws_s3_delivery), aws_s3_admin_delivery_path, method: :post %>
</p>

<% if (results = flash[:aws_s3_checks]).present? %>
<div class="autoscroll">
<table class="list checks" id="aws-s3-checks"><thead>
<tr>
    <th><%= l(:field_name) %></th>
    <th><%= l(:field_status) %></th>
    <th><%= l(:label_details) %></th>
</tr></thead>
<tbody>
<% results.each do |name, ok, detail| %>
<tr class="<%= ok ? 'ok' : 'failed' %>">
    <td class="name"><%= name %></td>
    <td class="tick">
      <span class="icon-only icon-<%= ok ? 'ok' : 'error' %>">
        <%= ok ? sprite_icon('checked', l(:label_aws_s3_ok)) : sprite_icon('warning', l(:label_aws_s3_failed)) %>
      </span>
    </td>
    <td class="description"><%= detail %></td>
</tr>
<% end %>
</tbody>
</table>
</div>
<% end %>

<% if RedmineAws::S3.malware_scan? || RedmineAws::S3::MalwareScan.findings.any? %>
<h3><%= l(:label_aws_s3_malware_findings) %></h3>

<% if (findings = RedmineAws::S3::MalwareScan.findings).any? %>
<div class="autoscroll">
<table class="list findings" id="aws-s3-malware"><thead>
<tr>
    <th><%= l(:label_aws_s3_time) %></th>
    <th><%= l(:label_aws_s3_scan_result) %></th>
    <th><%= l(:field_filename) %></th>
    <th><%= l(:label_user) %></th>
</tr></thead>
<tbody>
<% findings.each do |finding| %>
<% user = User.find_by_login(finding['user'].to_s) if finding['user'].present? %>
<tr>
    <td><%= finding['time'].present? ? format_time(Time.iso8601(finding['time'])) : '' %></td>
    <td><%= RedmineAws::S3::MalwareScan.status_label(finding['status']) %></td>
    <td class="name"><%= finding['filename'] %></td>
    <td class="name"><%= user ? link_to_user(user) : finding['user'] %></td>
</tr>
<% end %>
</tbody>
</table>
</div>
<% else %>
<p class="nodata"><%= l(:label_no_data) %></p>
<% end %>
<% end %>

<h3><%= l(:label_aws_s3_reconciliation) %></h3>

<p><%= link_to l(:button_aws_s3_reconcile), aws_s3_admin_reconcile_path, method: :post %></p>

<% if @reconciliation.blank? %>
<p class="nodata"><%= l(:label_no_data) %></p>
<% elsif @reconciliation['finished_at'].blank? %>
<div class="box tabular settings" id="aws-s3-reconciliation">
  <p><label><%= l(:field_status) %></label><%= l(:label_aws_s3_running) %></p>
  <p><label><%= l(:field_aws_s3_started_at) %></label><%= format_time(Time.iso8601(@reconciliation['started_at'])) %></p>
</div>
<% else %>
<div class="box tabular settings" id="aws-s3-reconciliation">
  <p><label><%= l(:field_aws_s3_finished_at) %></label><%= format_time(Time.iso8601(@reconciliation['finished_at'])) %></p>
  <p><label><%= l(:field_aws_s3_attachments) %></label><%= number_with_delimiter(@reconciliation['attachments']) %></p>
  <p><label><%= l(:field_aws_s3_objects) %></label><%= number_with_delimiter(@reconciliation['objects']) %> <em class="info">files/</em></p>
  <p><label><%= l(:field_aws_s3_missing) %></label><%= number_with_delimiter(@reconciliation['missing_count']) %></p>
  <p><label><%= l(:field_aws_s3_unused) %></label><%= number_with_delimiter(@reconciliation['unused_count']) %></p>
</div>
<% %w[missing unused].each do |kind| %>
<% if Array(@reconciliation[kind]).any? %>
<h4><%= l(:"field_aws_s3_#{kind}") %></h4>
<ul><% Array(@reconciliation[kind]).each do |key| %><li><code><%= key %></code></li><% end %></ul>
<% end %>
<% end %>
<% end %>
<% end %>

<h3><%= l(:label_settings) %></h3>

<%= form_tag(aws_s3_admin_path, method: :patch) do %>
<div class="box tabular settings">
  <% units = { 'download_url_expiry' => l(:label_aws_s3_seconds), 'upload_url_expiry' => l(:label_aws_s3_seconds), 'cache_size_mb' => 'MB' } %>
  <% @settings.each do |name, value| %>
  <p>
    <%= label_tag "settings_#{name}", l(:"field_aws_s3_#{name}") %>
    <%= text_field_tag "settings[#{name}]", value, size: 6 %> <%= units[name.to_s] %>
  </p>
  <% end %>
</div>

<%= submit_tag l(:button_save) %>
<% end %>
