#!/usr/bin/env bash
# Takes the screenshots of the docs (docs/images/, docs/ja/images/) in headless
# Chromium, from Redmine 7.0.3 with this plugin and Redmine's test data
# (test/screenshots/screens.rb, not named *_test.rb so that bin/test leaves
# it out), with S3 from moto, in Apple container when it runs, else in Docker
# (CONTAINER_CLI=container|docker chooses). Run it after changing a screen.
#   bin/screenshots
#   REDMINE_KIT_AWS_DIR=<dir> bin/screenshots   # redmine_kit_aws from <dir> (default ../redmine_kit_aws)
# Commands that run inside the container are in single quotes on purpose.
# shellcheck disable=SC2016
set -euo pipefail
cd "$(dirname "$0")/.."
source bin/container_cli
source bin/test_slot
plugin=redmine_kit_aws_s3
name=redmine-kit-aws-s3-test
bin/services --system >/dev/null
# Chromium is stopped afterwards; the other services stay for bin/test.
if [[ "$cli" == docker ]]; then
  trap 'release_test_slot; docker compose -f test/compose.yml -p "$name" stop chrome >/dev/null 2>&1' EXIT
else
  trap 'release_test_slot; container rm -f "$name-chrome" >/dev/null 2>&1' EXIT
fi
# The test image of bin/test (bin/test_image), on Ruby 4.0.
TEST_RUBY=4.0 source bin/test_image
mkdir -p docs/images docs/ja/images
# The browser opens the test server of this container: by its network alias
# in Docker, by its address in Apple container.
if [[ "$cli" == docker ]]; then
  opts=(--network "${name}_default" --network-alias redmine-screenshots)
  chrome=http://chrome:4444 moto=http://moto:5000 app_host=redmine-screenshots
else
  opts=(--network "$kit_test_network" -m 4G -e TEST_DATABASE_HOST="$(container_address "$name-postgres")")
  chrome="http://$(container_address "$name-chrome"):4444" moto="http://$(container_address "$name-moto"):5000" app_host=
fi
"$cli" run --rm "${opts[@]}" -e TEST_DATABASE="redmine_test_$$" \
  -e SELENIUM_REMOTE_URL="$chrome" -e CAPYBARA_SERVER_HOST=0.0.0.0 -e CAPYBARA_SERVER_PORT=3001 \
  -e CAPYBARA_APP_HOST="${app_host:+http://$app_host:3001}" -e GOOGLE_CHROME_OPTS_ARGS=--headless=new,--force-device-scale-factor=2 \
  -e PARALLEL_WORKERS=1 -e S3_TEST_ENDPOINT="$moto" -e AWS_REGION=us-east-1 \
  -e AWS_ACCESS_KEY_ID=test -e AWS_SECRET_ACCESS_KEY=test -v "$PWD/docs:/redmine/plugins/$plugin/docs" "$image" \
  sh -c 'export CAPYBARA_APP_HOST="${CAPYBARA_APP_HOST:-http://$(hostname -i | cut -d" " -f1):3001}"
    bin/rails db:drop db:create db:migrate redmine:plugins:migrate >/dev/null && bin/rails test "$1"
    status=$?; bin/rails db:drop >/dev/null 2>&1; exit $status' \
  screenshots "plugins/$plugin/test/screenshots/screens.rb"
