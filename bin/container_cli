# shellcheck shell=bash
# Sourced by the scripts in bin/: the container CLI to use in $cli, Apple
# container when it is installed and running, else Docker (other machines,
# CI); CONTAINER_CLI=container|docker chooses. With the helpers the scripts
# share for both tools.
if [[ -n "${CONTAINER_CLI:-}" ]]; then
  cli=$CONTAINER_CLI
elif command -v container >/dev/null && container system status >/dev/null 2>&1; then
  cli=container
else
  cli=docker
fi

# build_image <tag> <Dockerfile> <context> [<options>…]: builds an image
# quietly (options such as --build-arg go to the build), showing the build's
# log only when it fails (`container build -q` doesn't return).
build_image() {
  local tag=$1 file=$2 context=$3
  shift 3
  if [[ "$cli" == docker ]]; then
    docker buildx build --load -q -t "$tag" -f "$file" "$@" "$context" >/dev/null
    return
  fi
  local log
  log=$(mktemp)
  container build --progress plain -t "$tag" -f "$file" "$@" "$context" >"$log" 2>&1 ||
    { cat "$log" >&2; rm -f "$log"; return 1; }
  rm -f "$log"
}

# container_address <name> [<network>]: the IPv4 address of a running Apple
# container, on the network given or its first one. Containers on a network
# of their own don't find each other by name there, so the scripts pass
# addresses.
container_address() {
  container inspect "$1" | awk -v net="${2:-}" '
    /"ipv4Address"/ { split($0, a, "\""); ip = a[4]; sub(/\/.*/, "", ip) }
    /"network" :/ { split($0, b, "\""); if (ip != "" && (net == "" || b[4] == net)) { print ip; exit } }'
}

# container_running <name>: whether the Apple container runs.
container_running() {
  container inspect "$1" 2>/dev/null | grep -q '"state" : "running"'
}

# The networks of the tests in Apple container, shared by every Redmine Kit
# repository: one NAT network and one internal network (no way out, for the
# AWS tests), each with an anchor container that runs all the time. Apple
# container on macOS before 27.3 can give two NAT networks the same host
# bridge and deletes it when the last container of one of them stops, which
# leaves the other without its gateway: no DNS, no way out
# (apple/container#2051). Few networks whose bridges are never deleted avoid
# it. Container names stay per repository; the scripts never remove these
# networks or their anchors. Docker keeps a network per repository (Compose).
# shellcheck disable=SC2034 # used by the scripts that source this file
kit_test_network=redmine-kit-test
# shellcheck disable=SC2034
kit_test_internal_network=redmine-kit-test-internal

# ensure_shared_network <network> [--internal]: creates the network and starts
# its anchor (anchor-<network>) unless they exist and run, starts the anchor of
# the default network (image builds, bin/lint) too, and checks the network
# (check_network). Safe when several runs call it at once.
ensure_shared_network() {
  local network=$1
  shift
  container network inspect "$network" >/dev/null 2>&1 ||
    container network create "$@" "$network" >/dev/null 2>&1 ||
    container network inspect "$network" >/dev/null 2>&1 || # created by another run meanwhile
    { echo "Could not create the network $network: container network create $* $network" >&2; return 1; }
  ensure_network_anchor default && ensure_network_anchor "$network" && check_network "$network"
}

# ensure_network_anchor <network>: starts the anchor of the network unless it
# runs. Never removes it: another run may have just started it.
ensure_network_anchor() {
  local anchor=anchor-$1
  container inspect "$anchor" 2>/dev/null | grep -q '"state" : "running"' && return 0
  if container inspect "$anchor" >/dev/null 2>&1; then
    container start "$anchor" >/dev/null 2>&1 || true
  else
    container run -d --name "$anchor" --network "$1" -m 256M --cpus 1 --progress none \
      docker.io/library/alpine:3.22 sleep infinity >/dev/null 2>&1 || true
  fi
  container inspect "$anchor" 2>/dev/null | grep -q '"state" : "running"' ||
    { echo "The anchor of the network $1 did not start: container logs $anchor" >&2; return 1; }
}

# check_network <network>: fails with a message when the network is broken in
# one of the two ways apple/container#2051 shows: its gateway is on no
# interface of the host (no DNS, no way out), or the host no longer adds new
# containers to its bridge (the running ones still work; a new one reaches
# nothing). The check runs up to NETWORK_CHECK_ATTEMPTS times (default 5),
# NETWORK_CHECK_INTERVAL seconds apart (default 3), because the gateway can be
# missing for a moment and come back: only a failure that lasts is reported.
check_network() {
  local attempts=${NETWORK_CHECK_ATTEMPTS:-5} attempt broken
  for ((attempt = 1; ; attempt++)); do
    broken=$(network_problem "$1")
    [[ -n "$broken" ]] || return 0
    ((attempt < attempts)) || break
    sleep "${NETWORK_CHECK_INTERVAL:-3}"
  done
  echo "The container network $1 is broken: $broken (apple/container#2051; checked $attempts times)." >&2
  echo "Restart Apple container, then run this again: container system stop && container system start" >&2
  return 1
}

# network_problem <network>: what is wrong with the network now, read again on
# each call; nothing when it works. The symptom is a new short-lived container
# that can't reach the network's anchor (a few seconds); only then is the
# host's view of the gateway read, to say why. ifconfig's output depends on
# the caller's environment (a sandboxed shell may list no bridges), so a
# gateway it doesn't list is never a failure by itself, and an empty or failed
# ifconfig says nothing.
network_problem() {
  local anchor_address gateway interfaces
  anchor_address=$(container inspect "anchor-$1" 2>/dev/null | sed -n 's/.*"ipv4Address" : "\([0-9.]*\)\/.*/\1/p' | head -1)
  [[ -n "$anchor_address" ]] || return 0
  container run --rm --network "$1" -m 256M --progress none docker.io/library/alpine:3.22 \
    sh -c "for i in 1 2 3 4 5; do ping -c 1 -W 1 $anchor_address >/dev/null && exit 0; sleep 1; done; exit 1" \
    >/dev/null 2>&1 && return 0
  gateway=$(container network inspect "$1" 2>/dev/null | sed -n 's/.*"ipv4Gateway" : "\([0-9.]*\)".*/\1/p' | head -1)
  interfaces=$(ifconfig 2>/dev/null) || interfaces=
  if [[ -n "$gateway" && -n "$interfaces" ]] && ! grep -q "inet $gateway " <<<"$interfaces"; then
    echo "a new container on it reaches nothing, and its gateway $gateway is on no host interface"
  else
    echo "a new container on it reaches nothing"
  fi
}

# stop_services_at_exit <prefix>: when the calling script ends, however it
# ends (success, failure, Ctrl-C, a closed terminal), stops (does not remove)
# the containers named <prefix>-* that were not running when it called this,
# so that test services don't keep running after the tests (each is a VM with
# its memory in Apple container). A container that ran before (kept by
# KEEP_SERVICES, or started by hand) is left as it is. Runs of the same
# repository that overlap (two agents, a script that calls another) share the
# services: they are stopped when the last of these runs ends. With
# KEEP_SERVICES=1 nothing is stopped, and what is running stays running. Call
# it before the script starts any service. Anchors, the dev Redmine server and
# other repositories' containers have other names and are never touched.
# The stop runs in a process of its own that waits for the script to end,
# since the scripts replace each other's EXIT traps (bin/test_slot,
# bin/test_image) and a trap doesn't run when the script is killed.
stop_services_at_exit() {
  local prefix=$1 state run=$$
  state=${TMPDIR:-/tmp}/redmine-kit-services/$prefix
  mkdir -p "$state/runs"
  services_lock "$state"
  service_containers "$prefix" >"$state/runs/$run"
  services_unlock "$state"
  (
    trap '' INT TERM HUP
    while kill -0 "$run" 2>/dev/null; do sleep 1; done
    release_services "$prefix" "$state" "$run"
  ) </dev/null >/dev/null 2>&1 &
}

# service_containers <prefix>: the names of the running containers <prefix>-*.
service_containers() {
  if [[ "$cli" == docker ]]; then
    docker ps --format '{{.Names}}' 2>/dev/null
  else
    container ls -q 2>/dev/null
  fi | awk -v prefix="$1-" 'index($0, prefix) == 1' || true
}

# release_services <prefix> <state> <pid>: the end of the run <pid>. Adds the
# containers it started to those to stop, and stops them when no other run
# of these services is still running.
release_services() {
  local prefix=$1 state=$2 before=$2/runs/$3 file
  services_lock "$state"
  if [[ -n "${KEEP_SERVICES:-}" ]]; then
    rm -f "$state/started"
  elif [[ -f "$before" ]]; then
    service_containers "$prefix" | grep -vxF -f "$before" >>"$state/started" || true
  fi
  rm -f "$before"
  for file in "$state"/runs/*; do
    [[ -e "$file" ]] || continue
    if kill -0 "${file##*/}" 2>/dev/null; then
      services_unlock "$state"
      return 0
    fi
    rm -f "$file" # a run that ended without its release
  done
  if [[ -s "$state/started" ]]; then
    sort -u "$state/started" | while IFS= read -r file; do "$cli" stop "$file" >/dev/null 2>&1 || true; done
  fi
  rm -f "$state/started"
  services_unlock "$state"
}

# services_lock <state> / services_unlock <state>: one run at a time changes
# the state of a repository's services. A lock whose process is gone is taken
# over.
services_lock() {
  local me holder
  me=${BASHPID:-$(exec sh -c 'echo $PPID')}
  until mkdir "$1/lock" 2>/dev/null; do
    holder=$(cat "$1/lock/pid" 2>/dev/null || true)
    if [[ -n "$holder" ]] && ! kill -0 "$holder" 2>/dev/null; then rm -rf "$1/lock"; else sleep 1; fi
  done
  echo "$me" >"$1/lock/pid"
}
services_unlock() { rm -rf "$1/lock"; }
