# shellcheck shell=bash
# Sourced by bin/test, bin/test-gem and bin/screenshots after
# bin/container_cli: the image the tests run in ($image) and the options every
# run of it takes ($run_opts). No image is built for the plugin: $image is the
# base image of every Redmine Kit plugin's tests (test/Dockerfile: Ruby,
# Redmine 7.0.3 and its gems, with ImageMagick for the thumbnails), on the
# Ruby of TEST_RUBY (default 4.0), pinned in test/ruby-<version>.Dockerfile,
# whose FROM line replaces test/Dockerfile's. It is tagged with that
# Dockerfile's hash and built only when no image has that tag. The plugins
# come as files, mounted at /src/plugins: this checkout's run-time and test
# files and those of redmine_kit_aws, which the plugin requires (a checkout
# next to this one, or REDMINE_KIT_AWS_DIR), as they are in the working tree
# (tracked and new, not ignored). The image's entrypoint copies them into
# Redmine's plugins/ and installs the gems they add (their Gemfiles) into the
# plugin's named volume for that Ruby, kept between runs. A first run, on the
# network that reaches the internet, installs them, so that the tests can run
# on the internal network, which doesn't.
# $name: the base name of the tests' containers, set by the sourcing script.
: "${name:?}" "${cli:?}"
ruby_version=${TEST_RUBY:-4.0}
[[ -f "test/ruby-$ruby_version.Dockerfile" ]] || { echo "no test/ruby-$ruby_version.Dockerfile" >&2; exit 1; }
aws_dir=${REDMINE_KIT_AWS_DIR:-../redmine_kit_aws}
[[ -f "$aws_dir/init.rb" ]] || { echo "redmine_kit_aws is not in $aws_dir; set REDMINE_KIT_AWS_DIR" >&2; exit 1; }
# copy_plugin <checkout> <dir>: the files the plugin runs and tests with (not
# docs/, nor a checkout of redmine_kit_aws that CI puts inside this one).
copy_plugin() {
  mkdir -p "$2"
  (cd "$1" && git ls-files -co --exclude-standard |
    grep -E '^(init\.rb|Gemfile|[^/]*\.gemspec|LICENSE|(adapter|app|assets|boot|config|db|help|lib|schema|test)/)' |
    while IFS= read -r file; do if [[ -e "$file" ]]; then printf '%s\n' "$file"; fi; done | tar -cf - -T -) |
    tar -xf - -C "$2"
}
test_context=$(mktemp -d)
copy_plugin . "$test_context/plugins/redmine_kit_aws_s3"
copy_plugin "$aws_dir" "$test_context/plugins/redmine_kit_aws"
# redmine_kit_ui, for the tests of the new UI's tab (test/integration/
# kit_test.rb: the manifest it takes, the JSON of kit requests), not its app
# (frontend/: the tests need no build of it): REDMINE_KIT_UI=<dir>, default
# ../redmine_kit_ui, the checkout next to this one; REDMINE_KIT_UI_REF=<commit>,
# default HEAD. bin/test runs the plugin's tests with it and without it.
kit_ui=${REDMINE_KIT_UI:-../redmine_kit_ui}
kit_ui_ref=${REDMINE_KIT_UI_REF:-HEAD}
[[ -f "$kit_ui/init.rb" ]] || { echo "redmine_kit_ui is not in $kit_ui; set REDMINE_KIT_UI" >&2; exit 1; }
mkdir -p "$test_context/plugins/redmine_kit_ui"
git -C "$kit_ui" archive "$kit_ui_ref" init.rb Gemfile app assets config db lib test |
  tar -xf - -C "$test_context/plugins/redmine_kit_ui"
# Redmine from its repository instead of the 7.0.3 release: REDMINE_BRANCH=
# <branch> (master) at the branch's current commit, or REDMINE_COMMIT=<sha>;
# a base image of its own, tagged with the commit.
build_args=()
redmine_commit=${REDMINE_COMMIT:-}
if [[ -z "$redmine_commit" && -n "${REDMINE_BRANCH:-}" ]]; then
  redmine_commit=$(git ls-remote https://github.com/redmine/redmine.git "refs/heads/$REDMINE_BRANCH" | cut -f1)
  [[ -n "$redmine_commit" ]] || { echo "no branch $REDMINE_BRANCH in Redmine's repository" >&2; exit 1; }
fi
sed "s|^FROM ruby:[^ ]*|FROM $(sed -n 's/^FROM //p' "test/ruby-$ruby_version.Dockerfile")|" test/Dockerfile \
  >"$test_context/Dockerfile"
image=redmine-kit-test-base:$(shasum -a 256 "$test_context/Dockerfile" | cut -c1-12)
if [[ -n "$redmine_commit" ]]; then
  build_args=(--build-arg REDMINE_COMMIT="$redmine_commit")
  image=$image-${redmine_commit:0:12}
fi
# $test_image_args, when set, holds options for the build (--platform), which
# make an image of their own.
# shellcheck disable=SC2154 # test_image_args: optional, set by the sourcing script
if [[ -n "${test_image_args[*]:-}" ]]; then
  build_args+=("${test_image_args[@]}")
  image=$image-$(printf '%s ' "${test_image_args[@]}" | shasum -a 256 | cut -c1-8)
fi
# One build of an image at a time on this machine (the lock of every plugin's
# bin/test_slot).
test_build_lock="${TMPDIR:-/tmp}/redmine-kit-ui-test-slots/build"
mkdir -p "${test_build_lock%/*}"
if ! "$cli" image inspect "$image" >/dev/null 2>&1; then
  until mkdir "$test_build_lock" 2>/dev/null; do
    holder=$(cat "$test_build_lock/pid" 2>/dev/null || true)
    if [[ -n "$holder" ]] && ! kill -0 "$holder" 2>/dev/null; then rm -rf "$test_build_lock"; else sleep 2; fi
  done
  echo $$ >"$test_build_lock/pid"
  # another run may have built it while this one waited
  if ! "$cli" image inspect "$image" >/dev/null 2>&1; then
    mkdir "$test_context/empty"
    if [[ "$cli" == docker ]]; then
      docker buildx build --load -q -t "$image" "${build_args[@]}" -f "$test_context/Dockerfile" "$test_context/empty" \
        >/dev/null || { rm -rf "$test_build_lock"; exit 1; }
    else
      # The build's log only when it fails (`container build -q` doesn't return).
      log=$(mktemp)
      container build --progress plain -t "$image" ${build_args[@]+"${build_args[@]}"} -f "$test_context/Dockerfile" \
        "$test_context/empty" >"$log" 2>&1 || { cat "$log" >&2; rm -f "$log"; rm -rf "$test_build_lock"; exit 1; }
      rm -f "$log"
    fi
  fi
  rm -rf "$test_build_lock"
fi
# The plugin's gems volume holds one run at a time (Apple container attaches a
# named volume to one container only): runs of this plugin wait for each other.
gems_volume=$name-gems-ruby-$ruby_version
gems_lock="${TMPDIR:-/tmp}/$gems_volume.lock"
# A script that sources this file again while its caller holds the lock (as
# bin/update-schema does under redmine_kit_aws_dsql's bin/test) uses the
# caller's lock: GEMS_LOCK_OWNER names the process that took it, and only that
# process releases it. Waiting for its own caller would never end.
gems_lock_owned=""
if [[ -z "${GEMS_LOCK_OWNER:-}" || "$(cat "$gems_lock/pid" 2>/dev/null)" != "$GEMS_LOCK_OWNER" ]]; then
  # Another run of these tests: wait for it, at most GEMS_LOCK_TIMEOUT seconds
  # (default 3600), then stop with a message.
  gems_lock_waited=0
  until [[ "$(cat "$gems_lock/pid" 2>/dev/null)" == "$$" ]] || mkdir "$gems_lock" 2>/dev/null; do
    holder=$(cat "$gems_lock/pid" 2>/dev/null || true)
    if [[ -n "$holder" ]] && ! kill -0 "$holder" 2>/dev/null; then
      rm -rf "$gems_lock"
    elif ((gems_lock_waited >= ${GEMS_LOCK_TIMEOUT:-3600})); then
      echo "The gems volume of these tests is still in use by process ${holder:-?} (another run) after" \
        "${gems_lock_waited}s. Wait for it or stop it, then run again (GEMS_LOCK_TIMEOUT sets the wait)." >&2
      exit 1
    else
      sleep 3
      gems_lock_waited=$((gems_lock_waited + 3))
    fi
  done
  echo $$ >"$gems_lock/pid"
  export GEMS_LOCK_OWNER=$$
  gems_lock_owned=1
fi
# After the script's own clean-up (bin/test_slot's, the services'): `trap -p`
# quotes it, so that it is read back as it was.
eval "previous_exit_trap=($(trap -p EXIT))"
# shellcheck disable=SC2064,SC2154 # the variables at exit; the earlier clean-up as it is now
trap "rm -rf \"\$test_context\"${gems_lock_owned:+ \"\$gems_lock\"}${previous_exit_trap[2]:+; ${previous_exit_trap[2]}}" EXIT
run_opts=(-v "$test_context/plugins:/src/plugins" -v "$gems_volume:/extra-gems")
# The gems, on the network that reaches the internet (bin/services makes the
# tests' networks).
# shellcheck disable=SC2154 # kit_test_network: bin/container_cli
if [[ "$cli" == docker ]]; then
  "$cli" run --rm --network "${name}_default" "${run_opts[@]}" "$image" true
else
  "$cli" run --rm --network "$kit_test_network" "${run_opts[@]}" "$image" true
fi
