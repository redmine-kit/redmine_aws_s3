#!/usr/bin/env bash
# Starts PostgreSQL 16 and moto for the tests, on their own Compose project,
# and LocalStack when LOCALSTACK_AUTH_TOKEN is set.
#   bin/services          # start and wait until they answer
#   bin/services --down   # stop them
set -euo pipefail
cd "$(dirname "$0")/.."
compose=(docker compose -f test/compose.yml -p redmine-aws-s3-test)
if [[ -n "${LOCALSTACK_AUTH_TOKEN:-}" ]]; then
  compose+=(--profile localstack)
fi
# bin/services --system also starts Chromium for the system tests.
if [[ "${1:-}" == "--system" ]]; then
  compose+=(--profile system)
  shift
fi
if [[ "${1:-}" == "--down" ]]; then
  "${compose[@]}" down -v
  exit 0
fi
if ! "${compose[@]}" up -d --wait; then
  "${compose[@]}" logs --tail 80
  exit 1
fi
