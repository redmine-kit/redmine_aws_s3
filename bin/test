#!/usr/bin/env bash
# Tests (docs/setup.md#tests), in Docker: Redmine 7.0.3 with this plugin, on
# PostgreSQL 16, with S3 from LocalStack when LOCALSTACK_AUTH_TOKEN is set and
# from moto otherwise.
#   bin/test                  # the plugin's tests, with coverage in coverage/
#   bin/test core             # Redmine's own tests with the plugin installed (off)
#   bin/test system           # the plugin's system tests, in headless Chromium
#   bin/test core-s3          # Redmine's attachment tests with the plugin on
#                             # (test/core/s3_exclusions.txt lists those left out)
#   bin/test <files...>       # some of the plugin's tests
#   PARALLEL_WORKERS=1 bin/test
#   REDMINE_BRANCH=master bin/test   # on Redmine's master branch
#   REDMINE_AWS_DIR=<dir> bin/test   # redmine_aws from <dir> (default ../redmine_aws)
# Commands that run inside containers are in single quotes on purpose.
# shellcheck disable=SC2016
set -euo pipefail
cd "$(dirname "$0")/.."
image=redmine-aws-s3-test${REDMINE_BRANCH:+-$REDMINE_BRANCH}
network=redmine-aws-s3-test_default

if [[ "${1:-}" == "system" ]]; then
  bin/services --system >/dev/null
else
  bin/services >/dev/null
fi
# redmine_aws, which the plugin requires: a checkout next to this one, or
# REDMINE_AWS_DIR.
aws_dir=${REDMINE_AWS_DIR:-../redmine_aws}
[[ -f "$aws_dir/init.rb" ]] || { echo "redmine_aws is not in $aws_dir; set REDMINE_AWS_DIR" >&2; exit 1; }
docker buildx build --load -q -t "$image" --build-arg REDMINE_BRANCH="${REDMINE_BRANCH:-}" \
  --build-context redmine_aws="$aws_dir" -f test/Dockerfile . >/dev/null
workers="${PARALLEL_WORKERS:-$(getconf _NPROCESSORS_ONLN)}"
if [[ -n "${LOCALSTACK_AUTH_TOKEN:-}" ]]; then
  backend=localstack endpoint=http://localstack:4566
else
  backend=moto endpoint=http://moto:5000
fi
echo "S3 for the tests: $backend ($endpoint)"
run() {
  docker run --rm --network "$network" -e PARALLEL_WORKERS="$workers" "${extra[@]}" \
    -e S3_TEST_ENDPOINT="$endpoint" -e S3_TEST_BACKEND="$backend" -e AWS_REGION=us-east-1 \
    -e AWS_ACCESS_KEY_ID=test -e AWS_SECRET_ACCESS_KEY=test "$image" \
    sh -c 'bin/rails db:drop db:create db:migrate db:schema:dump >/dev/null && "$@"' run "$@"
}

extra=()
if [[ "${1:-}" == "system" ]]; then
  shift
  # The browser in the chrome container opens the test server of this
  # container by its network alias.
  extra=(--network-alias redmine-test -e SELENIUM_REMOTE_URL=http://chrome:4444
    -e CAPYBARA_SERVER_HOST=0.0.0.0 -e CAPYBARA_SERVER_PORT=3001 -e CAPYBARA_APP_HOST=http://redmine-test:3001)
  workers=1
  run bin/rails test plugins/redmine_aws_s3/test/system "$@"
elif [[ "${1:-}" == "core-s3" ]]; then
  shift
  # The tests whose names are in s3_exclusions.txt assume Redmine's local
  # storage; the file gives the reason for each.
  exclude=$(grep -v '^#' test/core/s3_exclusions.txt | sed 's/  *# .*//' | grep . | paste -sd '|' - || true)
  extra=(-e REDMINE_S3_TEST_CORE=1 -e REDMINE_S3_BUCKET="redmine-core-test-$RANDOM")
  files=(test/unit/attachment_test.rb test/unit/attachment_transaction_test.rb
    test/functional/attachments_controller_test.rb test/functional/attachments_visibility_test.rb
    test/integration/attachments_test.rb test/integration/api_test/attachments_test.rb)
  if [[ -n "$exclude" ]]; then
    run bin/rails test "${files[@]}" --exclude "/\\A(?:$exclude)\\z/" "$@"
  else
    run bin/rails test "${files[@]}" "$@"
  fi
elif [[ "${1:-}" == "core" ]]; then
  shift
  run bin/rails test "$@"
elif (($#)); then
  run bin/rails test "$@"
else
  # One process, so that SimpleCov sees every test (Redmine's helper starts
  # it when COVERAGE is set).
  rm -rf coverage && mkdir coverage
  workers=1
  extra=(-e COVERAGE=1 -v "$PWD/coverage:/redmine/plugins/redmine_aws_s3/coverage")
  run bin/rails test plugins/redmine_aws_s3/test/{unit,functional,integration}
fi
