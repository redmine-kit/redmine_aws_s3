#!/usr/bin/env bash
# Tests (docs/setup.md#tests), in Apple container when it runs, else in Docker
# (CONTAINER_CLI=container|docker chooses): Redmine 7.0.3 with this plugin, on
# PostgreSQL 16, with S3 from LocalStack when LOCALSTACK_AUTH_TOKEN is set and
# from moto otherwise.
#   bin/test                  # the plugin's tests
#   COVERAGE=1 bin/test       # with the coverage in coverage/coverage.xml, as the CI does
#   bin/test core             # Redmine's own tests with the plugin installed (off)
#   bin/test system           # the plugin's system tests, in headless Chromium
#   bin/test core-s3          # Redmine's attachment tests with the plugin on
#                             # (test/core/s3_exclusions.txt lists those left out)
#   bin/test <files...>       # some of the plugin's tests
#   PARALLEL_WORKERS=1 bin/test
#   REDMINE_BRANCH=master bin/test   # on Redmine's master branch
#   REDMINE_KIT_AWS_DIR=<dir> bin/test   # redmine_kit_aws from <dir> (default ../redmine_kit_aws)
# Commands that run inside containers are in single quotes on purpose.
# shellcheck disable=SC2016
set -euo pipefail
cd "$(dirname "$0")/.."
source bin/container_cli
source bin/test_slot
name=redmine-kit-aws-s3-test
if [[ "${1:-}" == "system" ]]; then
  bin/services --system >/dev/null
else
  bin/services >/dev/null
fi
test_image_args=(--build-arg REDMINE_BRANCH="${REDMINE_BRANCH:-}")
source bin/test_image
if [[ -n "${LOCALSTACK_AUTH_TOKEN:-}" ]]; then
  backend=localstack service=localstack port=4566
else
  backend=moto service=moto port=5000
fi
# The services by name in Docker; by address in Apple container, where
# containers on a network of their own don't find each other by name, with
# more memory than the 1 GB a container gets by default.
if [[ "$cli" == docker ]]; then
  endpoint=http://$service:$port
  opts=(--network "${name}_default")
  workers=${PARALLEL_WORKERS:-$(getconf _NPROCESSORS_ONLN)}
else
  endpoint=http://$(container_address "$name-$service"):$port
  opts=(--network "$kit_test_network" -m 4G -e TEST_DATABASE_HOST="$(container_address "$name-postgres")")
  workers=${PARALLEL_WORKERS:-2}
fi
echo "S3 for the tests: $backend ($endpoint)"
# A database of this run's own (test/database.yml), dropped when the tests end.
run() {
  "$cli" run --rm "${opts[@]}" -e PARALLEL_WORKERS="$workers" ${extra[@]+"${extra[@]}"} \
    -e TEST_DATABASE="redmine_test_$$" -e S3_TEST_ENDPOINT="$endpoint" -e S3_TEST_BACKEND="$backend" \
    -e AWS_REGION=us-east-1 -e AWS_ACCESS_KEY_ID=test -e AWS_SECRET_ACCESS_KEY=test "$image" \
    sh -c '[ -z "${SELENIUM_REMOTE_URL:-}" ] ||
        export CAPYBARA_APP_HOST="${CAPYBARA_APP_HOST:-http://$(hostname -i | cut -d" " -f1):3001}"
      bin/rails db:drop db:create db:migrate db:schema:dump >/dev/null && "$@"
      status=$?; bin/rails db:drop >/dev/null 2>&1; exit $status' run "$@"
}

extra=()
if [[ "${1:-}" == "system" ]]; then
  shift
  # The browser in the chrome container opens the test server of this
  # container: by its network alias in Docker, by its address in Apple
  # container (run reads it inside the container).
  if [[ "$cli" == docker ]]; then
    extra=(--network-alias redmine-test -e SELENIUM_REMOTE_URL=http://chrome:4444
      -e CAPYBARA_APP_HOST=http://redmine-test:3001)
  else
    extra=(-e SELENIUM_REMOTE_URL="http://$(container_address "$name-chrome"):4444")
  fi
  extra+=(-e CAPYBARA_SERVER_HOST=0.0.0.0 -e CAPYBARA_SERVER_PORT=3001)
  workers=1
  run bin/rails test plugins/redmine_kit_aws_s3/test/system "$@"
elif [[ "${1:-}" == "core-s3" ]]; then
  shift
  # The tests whose names are in s3_exclusions.txt assume Redmine's local
  # storage; the file gives the reason for each.
  exclude=$(grep -v '^#' test/core/s3_exclusions.txt | sed 's/  *# .*//' | grep . | paste -sd '|' - || true)
  extra=(-e REDMINE_S3_TEST_CORE=1 -e REDMINE_S3_BUCKET="redmine-core-test-$RANDOM")
  files=(test/unit/attachment_test.rb test/unit/attachment_transaction_test.rb
    test/functional/attachments_controller_test.rb test/functional/attachments_visibility_test.rb
    test/integration/attachments_test.rb test/integration/api_test/attachments_test.rb)
  if [[ -n "$exclude" ]]; then
    run bin/rails test "${files[@]}" --exclude "/\\A(?:$exclude)\\z/" "$@"
  else
    run bin/rails test "${files[@]}" "$@"
  fi
elif [[ "${1:-}" == "core" ]]; then
  shift
  run bin/rails test "$@"
elif (($#)); then
  run bin/rails test "$@"
else
  # With COVERAGE set: one process, so that SimpleCov sees every test
  # (Redmine's helper starts it when COVERAGE is set).
  if [[ -n "${COVERAGE:-}" ]]; then
    rm -rf coverage && mkdir coverage
    workers=1
    extra=(-e COVERAGE=1 -v "$PWD/coverage:/redmine/plugins/redmine_kit_aws_s3/coverage")
  fi
  run bin/rails test plugins/redmine_kit_aws_s3/test/{unit,functional,integration}
fi
